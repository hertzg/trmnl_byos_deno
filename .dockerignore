# Build-context hygiene: keep live (operator-owned) config out of the image.
# Only the committed *.example.ts starters and config/deno.json get baked;
# config/live/ is mounted at runtime (ADR-0010, ADR-0012).
# deno.lock ships with the build (ADR-0012 removed it from this list so the
# Dockerfile can use --frozen).
.git
.gitignore
.worktrees
.idea
.vscode
.claude
*.log
.DS_Store
docs

# Live config tree: all mutable operator content lives under config/live/.
config/live/
