{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@astral/astral": "jsr:@astral/astral@^0.5.4",
    "@std/encoding": "jsr:@std/encoding@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/crypto": "jsr:@std/crypto@^1.0.0",
    "imagescript": "https://deno.land/x/imagescript@1.3.0/mod.ts"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
