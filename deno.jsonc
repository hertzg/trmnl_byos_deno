{
  "tasks": {
    "dev": "deno run --allow-all --watch=src,templates src/main.ts",
    "start": "deno run --allow-all src/main.ts",
    "test": "deno test --allow-all",
    "bench": "deno bench --allow-all",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "wasm": "deno run -A scripts/build-wasm.ts"
  },
  "compilerOptions": {
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "unstable": ["raw-imports"],
  // AssemblyScript source files. asc hardcodes the .ts extension at parse time, so they have to
  // live on disk as *.as.ts even though they're not valid TypeScript (i32, v128, etc.). Excluding
  // them here keeps `deno check`, `deno test`, `deno lint`, and the LSP from trying to parse them.
  "exclude": ["src/**/*.as.ts"],
  "imports": {
    "@astral/astral": "jsr:@astral/astral@^0.5.4",
    // Mounted config tree (ADR-0010): plugins import their runtime config from
    // config/plugins/<plugin>/ via this alias instead of a relative path.
    // Mirrored in templates/example/deno.json (like @ds) so the alias resolves
    // whether the program is checked from the repo root or that nested config.
    "@config/": "./config/plugins/",
    "@ds": "./templates/ds/mod.ts",
    "@ds/": "./templates/ds/",
    "@hertzg/crc": "jsr:@hertzg/crc@^0.2.0",
    "@img/png": "jsr:@img/png@^0.1.6",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/bytes": "jsr:@std/bytes@^1.0.6",
    "@std/cache": "jsr:@std/cache@^0.2.3",
    "@std/encoding": "jsr:@std/encoding@^1.0.10",
    "@std/fs": "jsr:@std/fs@^1.0.0",
    "@std/math": "jsr:@std/math@^0.0.0",
    "@std/media-types": "jsr:@std/media-types@^1.0.0",
    "@std/path": "jsr:@std/path@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0",
    // Transport plugin source root. Lets the relocated config/plugins/transport/
    // routes files (which resolve via this root map) import the in-place
    // preference schema once they live outside templates/ (ADR-0010).
    "@transport/": "./templates/example/transport/",
    // Direct BVG HAFAS access for the transport plugin. The trailing-slash
    // entry is what lets the bvg profile subpath ("hafas-client/p/bvg/…")
    // resolve. Mirrored in templates/example/deno.json.
    "hafas-client": "npm:hafas-client@^6.3.6",
    "hafas-client/": "npm:/hafas-client@^6.3.6/",
    "hono": "jsr:@hono/hono@^4",
    "hono/deno": "jsr:@hono/hono@^4/deno",
    "hono/logger": "jsr:@hono/hono@^4/logger",
    "hono/jsx": "jsr:@hono/hono@^4/jsx",
    "hono/jsx/jsx-runtime": "jsr:@hono/hono@^4/jsx/jsx-runtime",
    "hono/jsx/dom/server": "jsr:@hono/hono@^4/jsx/dom/server"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": ["**/*.html", "templates/example/assets/"]
  }
}
