{
  "tasks": {
    "dev": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys --watch src/main.ts",
    "start": "deno run --allow-net --allow-env --allow-read --allow-run --allow-sys src/main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@astral/astral": "jsr:@astral/astral@^0.5.4"
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false
  }
}
