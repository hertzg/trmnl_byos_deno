{
  "name": "@hztrmnl/device-sim",
  // A developer tool, not part of the server: it plays the Device, making the
  // same HTTP requests the real firmware makes. Run it with `deno task device`.
  "exports": {
    ".": "./main.ts"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.0"
  }
}
