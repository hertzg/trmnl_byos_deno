.env
.env.*
!.env.example
deno.lock
.idea/
.vscode/
*.log
.DS_Store
.claude/

# Per-template private config (e.g. BVG stops/filters). The committed `*.example.ts`
# is the starter template; the active `routes.ts` is a local copy users edit and keep
# out of version control.
templates/**/routes.ts
!templates/**/routes.example.ts

# Live system config; the committed system.example.ts is the starter.
config/system.ts
!config/system.example.ts

# Mounted config tree (ADR-0010): same committed-example / gitignored-live split,
# at the relocated config/plugins/<plugin>/ home.
config/plugins/**/routes.ts
!config/plugins/**/routes.example.ts


templates/example/assets/gallery/*
!templates/example/assets/gallery/.gitkeep
