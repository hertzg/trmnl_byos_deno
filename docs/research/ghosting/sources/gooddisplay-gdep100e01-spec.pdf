172,570,172,561],"scale":2.3788211345672607,"text":"I"},{"contentSize":{"height":10,"width":7},"id":"7","polygon":[165,578,165,588,172,588,172,578],"scale":2.3788211345672607,"text":"I"},{"contentSize":{"height":10,"width":8},"id":"2","polygon":[164,596,164,606,172,606,172,596],"scale":2.3788211345672607,"text":"I"},{"contentSize":{"height":12,"width":139},"id":"79","polygon":[195,146,195,158,335,158,335,146],"scale":2.3788211345672607,"text":"Negative Gate driving voltage."},{"contentSize":{"height":13,"width":138},"id":"73","polygon":[193,180,193,193,331,193,331,181],"scale":2.3788211345672607,"text":"â€¦-ate driving voltage."},{"contentSize":{"height":11,"width":24},"id":"71","polygon":[242,198,242,208,266,208,266,198],"scale":2.3788211345672607,"text":"ction"},{"contentSize":{"height":13,"width":57},"id":"83","polygon":[336,128,336,141,393,141,393,128],"scale":2.3788211345672607,"text":"Description"},{"contentSize":{"height":11,"width":236},"id":"67","polygon":[196,216,196,227,432,227,432,216],"scale":2.3788211345672607,"text":"Digital power for source and gate driver \(Typ 3.3V\)"},{"contentSize":{"height":11,"width":337},"id":"66","polygon":[196,234,196,245,534,245,534,234],"scale":2.3788211345672607,"text":"Output enable for gate driver. When OEV=H, output is enabled and it is"},{"contentSize":{"height":10,"width":337},"id":"62","polygon":[196,251,196,261,533,261,533,251],"scale":2.3788211345672607,"text":"normal single pulse based on CKV. When OEH=L, all channel output"},{"contentSize":{"height":10,"width":70},"id":"61","polygon":[196,267,196,277,265,277,265,267],"scale":2.3788211345672607,"text":"forced to VGL."},{"contentSize":{"height":11,"width":338},"id":"60","polygon":[196,285,196,296,534,296,534,285],"scale":2.3788211345672607,"text":"Shift Clock for gate driver. The shift register data inside is shifted"},{"contentSize":{"height":11,"width":338},"id":"56","polygon":[196,302,196,313,534,313,534,302],"scale":2.3788211345672607,"text":"synchronously with each rising edge ofCKV. And high and Low period of"},{"contentSize":{"height":12,"width":313},"id":"55","polygon":[196,318,196,330,509,330,509,318],"scale":2.3788211345672607,"text":"CKV is related to turn on and off time for TFT element ofbackplane."},{"contentSize":{"height":11,"width":337},"id":"54","polygon":[196,336,196,347,533,347,533,336],"scale":2.3788211345672607,"text":"Start pulse for gate driver. The default state should be at H level and active"},{"contentSize":{"height":11,"width":46},"id":"50","polygon":[195,352,196,363,241,362,241,351],"scale":2.3788211345672607,"text":"atLlevel."},{"contentSize":{"height":10,"width":38},"id":"46","polygon":[196,370,196,380,233,380,233,370],"scale":2.3788211345672607,"text":"Ground."},{"contentSize":{"height":12,"width":80},"id":"42","polygon":[196,388,196,399,276,399,276,388],"scale":2.3788211345672607,"text":"Commonvoltage."},{"contentSize":{"height":11,"width":337},"id":"41","polygon":[196,405,196,417,533,417,533,405],"scale":2.3788211345672607,"text":"Clock for source driver. Sensing SPH input at rising edge and then makes"},{"contentSize":{"height":13,"width":338},"id":"37","polygon":[196,422,196,434,534,434,534,422],"scale":2.3788211345672607,"text":"the internal shift register enabled. Also, at the rising edge, it would catch"},{"contentSize":{"height":11,"width":337},"id":"36","polygon":[196,439,196,450,533,450,533,439],"scale":2.3788211345672607,"text":"the data bits and stored in the latchcircuit. CKH canÂ³t be toggled at OEH=L."},{"contentSize":{"height":10,"width":38},"id":"32","polygon":[196,457,196,467,233,467,233,457],"scale":2.3788211345672607,"text":"Ground."},{"contentSize":{"height":9,"width":71},"id":"29","polygon":[196,474,196,483,267,483,267,474],"scale":2.3788211345672607,"text":"No Connection."},{"contentSize":{"height":11,"width":157},"id":"24","polygon":[196,491,196,503,352,502,352,491],"scale":2.3788211345672607,"text":"ImageTTL Data for source driver."},{"contentSize":{"height":11,"width":156},"id":"20","polygon":[196,509,196,520,352,520,352,509],"scale":2.3788211345672607,"text":"Image TTL Data for source driver."},{"contentSize":{"height":12,"width":156},"id":"16","polygon":[196,526,196,538,352,538,352,525],"scale":2.3788211345672607,"text":"Image TTL Data for source driver."},{"contentSize":{"height":13,"width":157},"id":"12","polygon":[196,543,196,556,353,556,353,543],"scale":2.3788211345672607,"text":"Image TTL Data for source driver."},{"contentSize":{"height":11,"width":156},"id":"8","polygon":[196,561,196,573,352,572,352,561],"scale":2.3788211345672607,"text":"Image TTL Data for source driver."},{"contentSize":{"height":11,"width":156},"id":"4","polygon":[196,578,196,590,352,590,352,578],"scale":2.3788211345672607,"text":"Image TTL Data for source driver."},{"contentSize":{"height":11,"width":157},"id":"0","polygon":[196,596,196,607,352,607,352,595],"scale":2.3788211345672607,"text":"ImageTTL Datafor source driver."}]})/FastOCRPageID(C04654013112493EC17F1733433E7009)/Parent 2 0 R >>
