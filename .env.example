BYOS_DEVICE_MAC=AA:BB:CC:DD:EE:FF
BYOS_DEVICE_ACCESS_TOKEN=replace-with-device-token
PUBLIC_URL_ORIGIN=http://127.0.0.1:3000
PORT=3000
REFRESH_RATE_SECONDS=300
FRIENDLY_ID=TRMNL-X

# TRMNL X panel: 1872x1404 native (landscape). "portrait" generates 1404x1872
# and the firmware rotates it.
ORIENTATION=portrait

# 1, 2, or 4. Native is 4 (16 grays). Lower = smaller file.
IMAGE_BIT_DEPTH=4
