PUBLIC_URL_ORIGIN=http://127.0.0.1:3000
PORT=3000
FRIENDLY_ID=TRMNL-X

# Device profile id; looked up in src/render/profiles.ts at boot. Determines panel
# dimensions, dpr, bit depth, and dither mode. Unknown id fails fast at boot with
# the list of registered ids. Currently registered: trmnl-x.
DEVICE_ID=trmnl-x

# HTTP base of the CloakBrowser CDP container. Inside compose this resolves
# to the sidecar service. For non-Docker dev, run cloakbrowser locally and
# set CDP_URL=http://127.0.0.1:9222.
CDP_URL=http://chrome:9222

# Hostname the Renderer uses in the URL it hands CDP, and (when not
# 127.0.0.1) the bind interface for its loopback origin. Default
# "host.docker.internal" targets the common `deno task dev` workflow
# (deno on the host, chrome in docker) so it Just Works without env
# overrides. Setting anything other than 127.0.0.1 flips the bind to
# 0.0.0.0, which on a trusted single-user LAN (ADR-0001) is the
# deliberate trade-off for cross-namespace reachability.
#   - deno task dev + chrome in docker (Mac/Win, default): leave unset
#   - Linux without host-gateway: LOOPBACK_HOST=<docker bridge IP, e.g. 172.17.0.1>
#   - docker-compose: docker-compose.yml pins LOOPBACK_HOST=127.0.0.1 so
#     the ephemeral port stays on the loopback interface; nothing to do here.
# LOOPBACK_HOST=host.docker.internal
