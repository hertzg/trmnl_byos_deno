PUBLIC_URL_ORIGIN=http://127.0.0.1:3000
PORT=3000
FRIENDLY_ID=TRMNL-X

# Device profile id; looked up in src/render/profiles.ts at boot. Determines panel
# dimensions, dpr, bit depth, and dither mode. Unknown id fails fast at boot with
# the list of registered ids. Currently registered: trmnl-x.
DEVICE_ID=trmnl-x

# HTTP base of the CloakBrowser CDP container. Inside compose this resolves
# to the sidecar service. For non-Docker dev, run cloakbrowser locally and
# set CDP_URL=http://127.0.0.1:9222.
CDP_URL=http://chrome:9222

# URL the headless browser uses to fetch our HTML for rasterization. Must be reachable
# from chrome's network namespace.
#   - deno-on-host + chrome-in-docker (default `deno task dev` workflow, Mac):
#       INTERNAL_URL_ORIGIN=http://host.docker.internal:3000   (this is the default)
#   - docker-compose: set to http://trmnl-byos-dev:3000 in docker-compose.yml
#   - everything-on-host (chrome native binary): INTERNAL_URL_ORIGIN=http://127.0.0.1:3000
#   - Linux without host-gateway: set to the host's LAN IP
# INTERNAL_URL_ORIGIN=http://host.docker.internal:3000
