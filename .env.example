PUBLIC_URL_ORIGIN=http://127.0.0.1:3000
PORT=3000
REFRESH_RATE_SECONDS=300
FRIENDLY_ID=TRMNL-X

# HTTP base of the CloakBrowser CDP container. Inside compose this resolves
# to the sidecar service. For non-Docker dev, run cloakbrowser locally and
# set CDP_URL=http://127.0.0.1:9222.
CDP_URL=http://chrome:9222
